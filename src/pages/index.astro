---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: "SOC Analyst L1",
    company: "Coordinates",
    companyUrl: "https://cor.xyz",
    period: "23 Feb 2026 – Present",
    metrics: [
      { label: "Closed Tickets", value: "6k+" },
      { label: "Client Tenants", value: "15+" },
      { label: "Coverage", value: "Multi-SIEM / EDR" }
    ],
    description: "Operational frontline triage and threat monitoring across 15+ dedicated multi-tenant enterprise environments, maintaining rapid response SLAs and high detection quality.",
    bullets: [
      "Closed 6,000+ security tickets, performing alert enrichment, false-positive elimination, and incident containment.",
      "Triaged telemetry across disparate client deployments utilizing FortiSIEM, Microsoft Sentinel, and LogRhythm.",
      "Investigated process anomalies, lateral movement flags, and malicious scripts via CrowdStrike Falcon, Microsoft Defender for Endpoint (MDE), Cortex XDR, and FireEye HX.",
      "Coordinated directly with client security teams to deliver rapid containment playbooks and forensic summaries."
    ]
  }
];

const certifications = [
  {
    name: "eWPTX - Web Application Penetration Tester eXtreme",
    issuer: "eLearnSecurity",
    date: "Jan 2026",
    details: "Web application exploitation involving SQL injection, API abuse, CVEs, and Nmap reconnaissance."
  },
  {
    name: "eCDFP - Certified Digital Forensics Professional",
    issuer: "eLearnSecurity",
    date: "Apr 2025",
    details: "FAT/NTFS forensics, file carving, memory & network traffic analysis, Windows artifact inspection."
  },
  {
    name: "ECIH - Certified Incident Handler",
    issuer: "EC-Council",
    date: "Sep 2024",
    details: "Structured containment, threat detection, and remediation across email, endpoint, network, and cloud."
  }
];

const ctfAchievements = [
  { rank: "1st Place", event: "ICMTC 2025 CTF" },
  { rank: "2nd Place", event: "IEEE Aswan 2025 CTF" },
  { rank: "5th Place", event: "CYCTF 2024" },
  { rank: "6th Place", event: "CYCTF 2025" },
  { rank: "8th Place", event: "ICMTC 2024 Qualifications" }
];

const skills = {
  "Languages": ["Python", "C++", "Java", "SQL", "Bash"],
  "SIEM & Log Analysis": ["FortiSIEM", "Microsoft Sentinel", "LogRhythm", "Splunk", "Elastic SIEM", "QRadar"],
  "EDR & Endpoint Protection": ["CrowdStrike Falcon", "Microsoft Defender for Endpoint", "Cortex XDR", "FireEye HX"],
  "DFIR & Forensics Tools": ["Velociraptor", "Wireshark", "Volatility", "NetworkMiner"],
  "Offensive & Reverse Engineering": ["Burp Suite", "Metasploit", "IDA Pro", "Ghidra", "dnSpy", "Git"]
};
---

<BaseLayout title="Yousef AlZayat | SOC Analyst & Security Researcher">
  <!-- Hero Section -->
  <section class="py-12 border-b border-slate-800">
    <div class="inline-block px-3 py-1 mb-4 text-xs font-medium rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-800/60">
      SOC Analyst L1 • DFIR • Threat Detection
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      Yousef Ahmed AlZayat
    </h1>
    <p class="text-base text-slate-300 max-w-2xl leading-relaxed mb-6 font-sans">
      SOC Analyst at Coordinates and AI graduate specialized in threat detection, alert triage, and digital forensics. Active CTF player and security researcher with hands-on enterprise SIEM/EDR experience.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/writeups" class="px-5 py-2.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm transition">
        Read Write-ups →
      </a>
      <a href="mailto:yousefalzayat02@yahoo.com" class="px-5 py-2.5 rounded border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white font-medium text-sm transition">
        Contact Me
      </a>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience" class="py-12 border-b border-slate-800">
    <h2 class="text-xl font-mono text-emerald-400 mb-6 flex items-center gap-2">
      <span>01.</span> Professional Experience
    </h2>
    <div class="space-y-6">
      {experience.map((job) => (
        <div class="p-6 rounded-lg border border-slate-800 bg-slate-900/40">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-4">
            <div>
              <h3 class="text-lg font-bold text-white">{job.role}</h3>
              <a href={job.companyUrl} target="_blank" class="text-emerald-400 hover:underline text-sm font-semibold">
                @{job.company} ↗
              </a>
            </div>
            <span class="text-xs font-mono text-slate-400">{job.period}</span>
          </div>
  
          <!-- Metric Stat Badges -->
          <div class="grid grid-cols-3 gap-3 mb-5 font-mono">
            {job.metrics.map((m) => (
              <div class="p-2.5 rounded bg-slate-950/60 border border-slate-800 text-center">
                <div class="text-emerald-400 text-base font-bold">{m.value}</div>
                <div class="text-[10px] uppercase text-slate-400 tracking-wider">{m.label}</div>
              </div>
            ))}
          </div>
  
          <p class="text-sm text-slate-300 font-sans mb-4">{job.description}</p>
          <ul class="list-disc list-inside space-y-1.5 text-xs text-slate-400 font-sans">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- About & Education Section -->
  <section id="about" class="py-12 border-b border-slate-800 font-sans">
    <h2 class="text-xl font-mono text-emerald-400 mb-6 flex items-center gap-2">
      <span>02.</span> About & Education
    </h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-2 text-slate-300 space-y-4 leading-relaxed text-sm">
        <p>
          Cybersecurity professional and AI graduate with hands-on experience in threat detection, log triage, and incident response within high-volume security environments.
        </p>
        <p>
          Trained through specialized programs including the ITI DFIR Bootcamp (Splunk, Wireshark, Velociraptor) and hands-on networking/firewall labs across Cisco, FortiGate, and Palo Alto platforms.
        </p>
      </div>
      <div class="p-5 rounded-lg border border-slate-800 bg-slate-900/40 font-mono text-sm">
        <div class="text-xs text-slate-400 uppercase tracking-wide mb-1">Education</div>
        <div class="text-white font-semibold">B.Sc. in Computer Science</div>
        <div class="text-emerald-400 text-xs mt-1">Cairo University - AI Dept</div>
        <div class="text-slate-400 text-xs mt-2">Sept 2021 – June 2025</div>
        <div class="mt-3 inline-block px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800 text-xs font-bold">
          GPA: 3.83
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications Section -->
  <section id="certifications" class="py-12 border-b border-slate-800">
    <h2 class="text-xl font-mono text-emerald-400 mb-6 flex items-center gap-2">
      <span>03.</span> Certifications
    </h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {certifications.map((cert) => (
        <div class="p-5 rounded-lg border border-slate-800 bg-slate-900/30 flex flex-col justify-between">
          <div>
            <div class="text-xs text-emerald-400 font-mono mb-1">{cert.date}</div>
            <h3 class="text-sm font-semibold text-white mb-2">{cert.name}</h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans">{cert.details}</p>
          </div>
          <span class="text-xs text-slate-500 mt-4 block">{cert.issuer}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Achievements Section -->
  <section class="py-12 border-b border-slate-800">
    <h2 class="text-xl font-mono text-emerald-400 mb-6 flex items-center gap-2">
      <span>04.</span> CTF Track Record
    </h2>
    <div class="grid sm:grid-cols-3 lg:grid-cols-5 gap-3 font-mono">
      {ctfAchievements.map((item) => (
        <div class="p-4 rounded border border-slate-800 bg-slate-900/40 text-center">
          <div class="text-emerald-400 text-sm font-bold">{item.rank}</div>
          <div class="text-xs text-slate-300 mt-1">{item.event}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="py-12">
    <h2 class="text-xl font-mono text-emerald-400 mb-6 flex items-center gap-2">
      <span>05.</span> Technical Inventory
    </h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-5 rounded border border-slate-800 bg-slate-900/20">
          <h3 class="text-xs uppercase tracking-wider text-slate-400 mb-3">{category}</h3>
          <div class="flex flex-wrap gap-2">
            {items.map((skill) => (
              <span class="px-2.5 py-1 text-xs rounded bg-slate-800 text-slate-300 border border-slate-700">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>